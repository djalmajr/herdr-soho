# Example --env-file for a macOS (or Linux) host. Copy it outside the
# repository, adjust the paths, and keep key files outside any checkout.
HERDR_SOHO_IMAGE=herdr-soho-base:0.1.0
JOB_WORKSPACE=/path/to/jobs/<id>/repo
ANTHROPIC_API_KEY_FILE=/path/to/secrets/anthropic_api_key
OPENAI_API_KEY_FILE=/path/to/secrets/openai_api_key
XAI_API_KEY_FILE=/path/to/secrets/xai_api_key
HERMES_CREDENTIALS_FILE=/path/to/secrets/hermes_credentials
CINZEL_CREDENTIALS_FILE=/path/to/secrets/cinzel_credentials
AI_MEMORY_CREDENTIALS_FILE=/path/to/secrets/ai_memory_credentials
