# Example --env-file for a Windows host with Docker Desktop (WSL 2 backend).
# Windows paths use forward slashes or escaped backslashes. Keep the job
# checkout with core.autocrlf=false so scripts and fixtures keep LF endings.
HERDR_SOHO_IMAGE=herdr-soho-base:0.1.0
JOB_WORKSPACE=C:/jobs/<id>/repo
ANTHROPIC_API_KEY_FILE=C:/secrets/anthropic_api_key
OPENAI_API_KEY_FILE=C:/secrets/openai_api_key
XAI_API_KEY_FILE=C:/secrets/xai_api_key
HERMES_CREDENTIALS_FILE=C:/secrets/hermes_credentials
CINZEL_CREDENTIALS_FILE=C:/secrets/cinzel_credentials
AI_MEMORY_CREDENTIALS_FILE=C:/secrets/ai_memory_credentials
