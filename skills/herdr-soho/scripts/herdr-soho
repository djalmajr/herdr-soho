#!/bin/sh
# herdr-soho — prefer the installed Go binary; keep the JS entry as a fallback.

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 2
script_path=$script_dir/$(basename -- "$0")

# The installed binary lives outside the skill tree: tell it where the skill is.
if [ -z "${HERDR_SOHO_SKILL_DIR:-}" ]; then
  HERDR_SOHO_SKILL_DIR=$(CDPATH= cd -- "$script_dir/.." && pwd -P) || exit 2
  export HERDR_SOHO_SKILL_DIR
fi

resolve_path() {
  resolved=$1
  resolved=$(CDPATH= cd -- "$(dirname -- "$resolved")" && pwd -P)/$(basename -- "$resolved") || return 1
  hops=0
  while [ -L "$resolved" ] && [ "$hops" -lt 40 ]; do
    target=$(readlink "$resolved" 2>/dev/null) || return 1
    case $target in
      /*) resolved=$target ;;
      *) resolved=$(dirname -- "$resolved")/$target ;;
    esac
    resolved=$(CDPATH= cd -- "$(dirname -- "$resolved")" && pwd -P)/$(basename -- "$resolved") || return 1
    hops=$((hops + 1))
  done
  [ -f "$resolved" ] || return 1
  printf '%s\n' "$resolved"
}

is_binary() {
  [ -f "$1" ] && [ -x "$1" ] || return 1
  first_bytes=$(dd if="$1" bs=2 count=1 2>/dev/null)
  [ "$first_bytes" = '#!' ] && return 1
  return 0
}

# A candidate outside the PATH (the install directories below): executable,
# not a shebang script, not this launcher itself; sets candidate_path.
usable_candidate() {
  [ -n "$1" ] || return 1
  is_binary "$1" || return 1
  candidate_path=$(resolve_path "$1" 2>/dev/null || true)
  [ -n "$candidate_path" ] || return 1
  [ "$candidate_path" != "$own_path" ]
}

if [ "${HERDR_SOHO_JS:-}" = 1 ]; then
  js_only=1
else
  js_only=0
fi

if [ "$js_only" -eq 0 ]; then
  if [ "${HERDR_SOHO_BIN+x}" = x ]; then
    if ! is_binary "$HERDR_SOHO_BIN"; then
      printf 'herdr-soho: HERDR_SOHO_BIN is missing or not an executable binary: %s\n' "$HERDR_SOHO_BIN" >&2
      exit 2
    fi
    exec "$HERDR_SOHO_BIN" "$@"
  fi

  own_path=$(resolve_path "$script_path" 2>/dev/null || true)

  path_bin=$(command -v herdr-soho 2>/dev/null || true)
  if [ -n "$path_bin" ] && is_binary "$path_bin"; then
    candidate_path=$(resolve_path "$path_bin" 2>/dev/null || true)
    if [ -n "$candidate_path" ] && [ "$candidate_path" != "$own_path" ]; then
      exec "$path_bin" "$@"
    fi
  fi

  # A shell opened before the install keeps a PATH without the binary:
  # try where install.sh (HERDR_SOHO_INSTALL_DIR or ~/.local/bin) or
  # install.ps1 (Git Bash: %LOCALAPPDATA%) put it.
  if [ -n "${HERDR_SOHO_INSTALL_DIR:-}" ]; then
    # install.ps1 names it herdr-soho.exe (Git Bash on Windows).
    for candidate in "$HERDR_SOHO_INSTALL_DIR/herdr-soho" "$HERDR_SOHO_INSTALL_DIR/herdr-soho.exe"; do
      if usable_candidate "$candidate"; then
        exec "$candidate" "$@"
      fi
    done
  fi
  if [ -n "${HOME:-}" ]; then
    candidate="$HOME/.local/bin/herdr-soho"
    if usable_candidate "$candidate"; then
      exec "$candidate" "$@"
    fi
  fi
  if [ -n "${LOCALAPPDATA:-}" ]; then
    candidate="$LOCALAPPDATA/Programs/herdr-soho/herdr-soho.exe"
    if usable_candidate "$candidate"; then
      exec "$candidate" "$@"
    fi
  fi
fi

# One warning before the JavaScript fallback, only when it is a fallback:
# HERDR_SOHO_JS=1 asked for the JavaScript on purpose.
run_js_fallback() {
  if [ "$js_only" -eq 0 ]; then
    printf 'herdr-soho: warning: the herdr-soho binary was not found (PATH or the install directory); running the JavaScript fallback, which lags the binary; reopen the shell after installing, or set HERDR_SOHO_BIN\n' >&2
  fi
  exec "$@"
}

node_bin=$(command -v node 2>/dev/null || true)
if [ -n "$node_bin" ]; then
  node_major=$("$node_bin" -e 'process.stdout.write(String(process.versions.node.split(".")[0]))' 2>/dev/null || true)
  case $node_major in
    ''|*[!0-9]*) : not a usable node version ;;
    *)
      if [ "$node_major" -ge 20 ]; then
        run_js_fallback "$node_bin" "$script_dir/herdr-soho.mjs" "$@"
      fi
      ;;
  esac
fi

bun_bin=$(command -v bun 2>/dev/null || true)
if [ -n "$bun_bin" ]; then
  run_js_fallback "$bun_bin" "$script_dir/herdr-soho.mjs" "$@"
fi

printf 'herdr-soho: install the herdr-soho binary (install.sh / install.ps1 from the GitHub releases) or Node.js 20+ / Bun\n' >&2
exit 2
